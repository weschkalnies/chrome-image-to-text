{
  "manifest_version": 3,
  "name": "LocalOCR: Screen to Text",
  "version": "1.1.0",
  "description": "Select any area on screen and convert it to text locally using Tesseract OCR. 100% offline.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Start Screen OCR",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
