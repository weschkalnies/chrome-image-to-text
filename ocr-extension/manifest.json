{
  "manifest_version": 3,
  "name": "Local Screen OCR",
  "version": "1.0.2",
  "description": "Erfasst einen Bereich des Bildschirms und wandelt ihn lokal via Tesseract OCR in Text um. 100% offline.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Screenshot OCR starten",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/tesseract.min.js",
        "lib/worker.min.js",
        "lib/tesseract-core-simd.wasm.js",
        "lib/tesseract-core-simd.wasm",
        "lib/tesseract-core-simd-lstm.wasm.js",
        "lib/tesseract-core-simd-lstm.wasm",
        "lib/eng.traineddata.gz",
        "lib/deu.traineddata.gz"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
