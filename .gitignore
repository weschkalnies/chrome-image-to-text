node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.pnp
.pnp.js
# Lockfiles: ggf. wieder reinnehmen, wenn du reproduzierbare Builds teilen willst
yarn.lock
pnpm-lock.yaml

# ---------- Build / Distribution ----------
dist/
build/
out/
# Gepackte Extension-Releases & privater Signier-Key NICHT ins Repo
*.zip
*.crx
*.pem
releases/
release/

# ---------- Test-Artefakte ----------
