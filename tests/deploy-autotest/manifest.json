{
  "manifest_version": 3,
  "name": "LocalOCR: Screen to Text",
  "version": "1.0.9",
  "description": "Select any area on screen and convert it to text locally using Tesseract OCR. 100% offline.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Start Screen OCR",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/tesseract.min.js",
        "lib/worker.min.js",
        "lib/tesseract-core-simd.wasm.js",
        "lib/tesseract-core-simd.wasm",
        "lib/tesseract-core-simd-lstm.wasm.js",
        "lib/tesseract-core-simd-lstm.wasm",
        "lib/eng.traineddata.gz",
        "lib/deu.traineddata.gz"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
